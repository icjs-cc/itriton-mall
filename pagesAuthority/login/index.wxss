page {
  --login-bg: #fff8ee;
  --login-ink: #463426;
  --login-muted: #796b5c;
  --login-border: #e9e1d6;
  --login-error: #b5382d;
  background: var(--login-bg);
}

.login-page {
  min-height: 100%;
  box-sizing: border-box;
  padding: 16rpx 32rpx 48rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, var(--login-bg) 0%, #fffdf9 65%, #ffffff 100%);
  color: var(--login-ink);
}

.login-main {
  max-width: 750rpx;
  margin: 0 auto;
}

.login-hero {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 324rpx;
  padding-left: 16rpx;
  box-sizing: border-box;
}

.login-hero__copy {
  position: relative;
  z-index: 1;
  width: 320rpx;
}

.login-hero__brand {
  font-size: var(--font-size-xxs, 20rpx);
  font-weight: var(--font-weight-semibold, 600);
  letter-spacing: 3rpx;
  color: var(--login-muted);
}

.login-hero__title {
  margin-top: 20rpx;
  font-size: 52rpx;
  font-weight: var(--font-weight-semibold, 600);
  line-height: 1.3;
  letter-spacing: 2rpx;
}

.login-hero__subtitle {
  margin-top: 16rpx;
  font-size: var(--font-size-sm, 24rpx);
  line-height: 1.7;
  color: var(--login-muted);
}

.login-hero__image {
  position: absolute;
  width: 360rpx;
  height: 360rpx;
  right: -8rpx;
  top: -8rpx;
}

.login-card {
  position: relative;
  padding: 40rpx;
  border: 1rpx solid rgba(233, 225, 214, 0.65);
  border-radius: 32rpx;
  background: var(--color-card, #ffffff);
  box-shadow: 0 16rpx 48rpx rgba(101, 72, 35, 0.05);
}

.login-card__title {
  font-size: var(--font-size-xl, 36rpx);
  font-weight: var(--font-weight-semibold, 600);
  line-height: 1.4;
}

.login-card__subtitle {
  margin-top: 8rpx;
  margin-bottom: 36rpx;
  font-size: var(--font-size-sm, 24rpx);
  color: var(--login-muted);
}

.login-field + .login-field {
  margin-top: 28rpx;
}

.login-field__label {
  display: block;
  margin-bottom: 12rpx;
  font-size: var(--font-size-md, 28rpx);
  font-weight: var(--font-weight-medium, 500);
}

.login-field__control {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  box-sizing: border-box;
  padding: 0 24rpx;
  border: 2rpx solid var(--login-border);
  border-radius: 20rpx;
  background: #fcfaf7;
  transition: border-color 180ms ease, background-color 180ms ease;
}

.login-field__control--focus {
  border-color: var(--color-primary, #dcaa6b);
  background: #fff;
}

.login-field__control--error {
  border-color: var(--login-error);
}

.login-field__input {
  flex: 1;
  min-width: 0;
  height: 92rpx;
  font-size: 30rpx;
  line-height: 1.5;
  color: var(--login-ink);
}

.login-field__placeholder {
  color: #8b8175;
  font-size: var(--font-size-md, 28rpx);
}

.login-password-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 96rpx;
  min-height: 92rpx;
  margin-right: -20rpx;
  font-size: var(--font-size-sm, 24rpx);
  color: #805525;
  background: transparent;
  border-radius: 16rpx;
}

.login-field__error,
.login-form-error {
  margin-top: 12rpx;
  font-size: var(--font-size-sm, 24rpx);
  line-height: 1.5;
  color: var(--login-error);
}

.login-form-error {
  margin-top: 28rpx;
}

.login-submit {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 96rpx;
  margin-top: 40rpx;
  border-radius: 20rpx;
  background: linear-gradient(110deg, #e8be88, var(--color-primary, #dcaa6b));
  color: #50351d;
  font-size: var(--font-size-lg, 32rpx);
  font-weight: var(--font-weight-semibold, 600);
  box-shadow: 0 8rpx 20rpx rgba(190, 137, 69, 0.14);
  transition: opacity 180ms ease;
}

.login-submit[disabled] {
  background: #ead8c0;
  color: var(--login-muted);
  box-shadow: none;
}

.login-submit--pressed,
.login-text--pressed {
  opacity: 0.72;
}

.login-browse {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 96rpx;
  width: 240rpx;
  margin: 24rpx auto 0;
  color: var(--login-muted);
  font-size: var(--font-size-md, 28rpx);
  background: transparent;
}

.login-browse__arrow {
  margin-left: 12rpx;
  font-size: 38rpx;
  line-height: 1;
}

.login-footer {
  margin-top: 24rpx;
  text-align: center;
  font-size: var(--font-size-xs, 22rpx);
  letter-spacing: 3rpx;
  color: var(--login-muted);
}

@media (max-height: 700px) {
  .login-hero {
    min-height: 264rpx;
  }
  .login-hero__image {
    width: 300rpx;
    height: 300rpx;
    top: -16rpx;
  }
  .login-card {
    padding: 32rpx;
  }
  .login-footer {
    margin-top: 8rpx;
  }
}

@media (prefers-reduced-motion: reduce) {
  .login-field__control,
  .login-submit {
    transition: none;
  }
}
