/* component/word-cloud/index.wxss */

.word-cloud {
  position: relative;
  width: 100%;
  overflow: hidden;
}

.word-cloud__cell {
  position: absolute;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  left: 0rpx;
  top: 0rpx;
}

.word-cloud__cell--tag {
  padding: 5rpx 15rpx;
  border-radius: var(--radius, 16rpx);
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: #fff;
}