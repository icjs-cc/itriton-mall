/* component/image/index.wxss */

.image {
  width: 100%;
  height: 100%;
  background-size: 100% 100%;
  vertical-align: bottom;
}

.t-avatar-square {
  border-radius: var(--radius, 16rpx);
}

.t-avatar-rectangle {
  border-radius: var(--radius, 16rpx);
}

.t-avatar-circle {
  border-radius: 50%;
}