.mine-wrap {
  min-height: 100%;
  padding-bottom: 48rpx;
}

.mine__bg {
  position: relative;
  height: 240rpx;
  background-repeat: no-repeat;
  background-size: cover;
  background-position: center bottom;
}

.mine__info {
  position: absolute;
  left: 40rpx;
  right: 32rpx;
  bottom: 76rpx;
  display: flex;
  align-items: center;
}

.mine__bg--avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.92);
  box-sizing: border-box;
  background: #fff;
  flex-shrink: 0;
}

.mine__info--cell {
  margin-left: 24rpx;
  min-width: 0;
}

.mine__info--name {
  font-size: var(--font-size-xl);
  font-weight: var(--font-weight-semibold);
  line-height: 1.3;
  color: #fff;
}

.mine__info--desc {
  margin-top: 8rpx;
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-regular);
  line-height: 1.4;
  color: rgba(255, 255, 255, 0.88);
}

.mine__body {
  position: relative;
  z-index: 2;
  margin-top: -48rpx;
  padding: 0 var(--space-page);
}

.mine-card {
  background: #fff;
  border-radius: var(--radius, 16rpx);
  overflow: hidden;
  box-shadow: var(--shadow-card);
}

.mine-card + .mine-card {
  margin-top: var(--space-section);
}

.mine-order-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-card) var(--space-card) var(--space-tight);
}

.mine-order-title {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text);
}

.mine-order-more {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: #f6f6f6;
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-regular);
  line-height: 1.4;
  color: var(--color-text-secondary);
}

.mine-order-grid {
  display: flex;
  padding: var(--space-page) 8rpx var(--space-card);
}

.mine-order-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.mine-order-num {
  font-size: var(--font-size-xl);
  font-weight: var(--font-weight-semibold);
  line-height: 1.2;
  color: var(--color-text);
}

.mine-order-label {
  margin-top: 10rpx;
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-regular);
  color: var(--color-text-secondary);
}

.mine-cell {
  padding: var(--space-card) !important;
  margin: 0;
  background: #fff;
  border-radius: 0 !important;
}
