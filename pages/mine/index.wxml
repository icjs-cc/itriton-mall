<page id="page" default-loading="{{false}}">
  <view class="mine-wrap">
    <view class="mine-content">
      <button wx:if="{{!userInfo.userId}}" class="mine-profile" bindtap="routeToLogin" hover-class="mine-pressed" aria-label="立即登录，体验完整功能">
        <image class="mine-avatar" src="/images/mine/avatar-v2.png" mode="aspectFill" aria-hidden="true" />
        <view class="mine-profile__copy">
          <view class="mine-profile__brand">{{project_cn}}</view>
          <view class="mine-profile__name">立即登录</view>
          <view class="mine-profile__desc">和小鲸一起，发现生活好物</view>
        </view>
        <view class="mine-profile__action" aria-hidden="true"><view class="mine-chevron" /></view>
      </button>
      <view wx:else class="mine-profile">
        <image class="mine-avatar" src="/images/mine/avatar-v2.png" mode="aspectFill" aria-label="用户头像" />
        <view class="mine-profile__copy">
          <view class="mine-profile__brand">{{project_cn}}</view>
          <view class="mine-profile__name mine-profile__nickname">{{userInfo.nickname || '小鲸用户'}}</view>
          <view class="mine-profile__desc">欢迎回来，今天也有好物相伴</view>
        </view>
      </view>

      <view class="mine-card mine-orders">
        <view class="mine-card__head">
          <view class="mine-card__title">我的订单</view>
          <button class="mine-order-more" data-status="all" bindtap="openOrders" hover-class="mine-pressed" aria-label="查看全部订单">
            全部订单<view class="mine-chevron mine-chevron--small" aria-hidden="true" />
          </button>
        </view>
        <view class="mine-order-grid">
          <button wx:for="{{orderEntries}}" wx:key="status" class="mine-order-item" data-status="{{item.status}}" bindtap="openOrders" hover-class="mine-pressed" aria-label="{{item.name}}，{{orderCount[item.status]}}笔订单">
            <view class="mine-order-symbol" aria-hidden="true">
              <view class="mine-order-icon mine-order-icon--{{item.status}}" />
              <view wx:if="{{orderCount[item.status] > 0}}" class="mine-order-badge {{item.status === 'done' ? 'mine-order-badge--done' : ''}}">{{orderCount[item.status] > 99 ? '99+' : orderCount[item.status]}}</view>
            </view>
            <view class="mine-order-label">{{item.name}}</view>
          </button>
        </view>
      </view>

      <view class="mine-card mine-services">
        <view class="mine-card__head">
          <view class="mine-card__title">常用服务</view>
          <view class="mine-card__hint">贴心服务，轻松购物</view>
        </view>
        <view class="mine-service-grid">
          <button wx:for="{{services}}" wx:key="icon" class="mine-service" open-type="{{item.openType}}" data-isauth="{{item.isauth}}" data-url="{{item.url}}" bindtap="routeToNext" hover-class="mine-pressed" aria-label="{{item.name}}">
            <view class="mine-service__icon" aria-hidden="true"><iconfont icon="{{item.icon}}" color="#946536" size="42rpx" /></view>
            <view class="mine-service__name">{{item.name}}</view>
          </button>
        </view>
      </view>

      <view class="mine-footer">
        <view class="mine-footer__rule" />
        <text>好物相伴 · 悦享生活</text>
        <view class="mine-footer__rule" />
      </view>
    </view>
  </view>
</page>
