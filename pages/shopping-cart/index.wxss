/* pages/shopping-cart/index.wxss */
.shopping-cart-cover {
  width: 156rpx;
  height: 156rpx;
  flex-shrink: 0;
  overflow: hidden;
  box-sizing: border-box;
  border: 1rpx solid #E5E9E8;
  border-radius: var(--radius, 16rpx);
}

.shopping-cart-image {
  display: block;
  width: 100%;
  height: 100%;
}

.shopping-cart-price {
  margin-left: -10rpx
}

.shopping-cart-content{
  height: 152rpx;
}

.button-submit>button {
  border-radius: 999rpx !important;
  box-shadow: 0 5rpx 10rpx rgba(0, 0, 0, 0.09) !important;
  height: 75rpx !important;
  line-height: 75rpx !important;
}
