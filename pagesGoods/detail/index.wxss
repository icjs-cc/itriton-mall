/* pagesGoods/detail/index.wxss */
.goods-banner,
.goods-info,
.goods-desc {
  background: var(--color-card, #fff);
}

.goods-info-name {
  font-size: 32rpx;
  line-height: 40rpx;
}

.goods-info-desc {
  font-size: 28rpx;
  line-height: 32rpx;
  margin-top: 20rpx;
  color: var(--color-text-secondary, #888);
}

.goods-info-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
}

.goods-info-price {
  font-size: 38rpx;
  color: var(--color-price, #e54d42);
  margin-left: -5rpx;
}

.goods-desc {
  color: var(--color-text, #333);
}

.custom-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: var(--color-text, #333);
  background: transparent;
  padding: 0;
  margin: 0;
}

.custom-btn::after {
  border: none;
}

.custom-btn-icon {
  height: 50rpx;
}

.custom-btn-text {
  height: 30rpx;
  line-height: 30rpx;
}

.submit-btn-left {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFF;
  min-width: 240rpx;
  width: 100%;
  height: 76rpx;
  opacity: 1;
  border-radius: 38rpx 0 0 38rpx;
}

.submit-btn-right {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFF;
  min-width: 240rpx;
  width: 100%;
  height: 76rpx;
  opacity: 1;
  border-radius: 0 38rpx 38rpx 0;
}