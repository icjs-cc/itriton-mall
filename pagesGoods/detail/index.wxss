/* pagesGoods/detail/index.wxss */
.goods-banner,
.goods-info,
.goods-desc {
  background: var(--color-card, #fff);
}

.goods-info-name {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  line-height: 1.4;
  color: var(--color-text);
}

.goods-info-desc {
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-regular);
  line-height: 1.5;
  margin-top: 12rpx;
  color: var(--color-text-secondary);
}

.goods-info-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
}

.goods-info-price {
  font-size: var(--font-size-xl);
  font-weight: var(--font-weight-semibold);
  line-height: 1.2;
  color: var(--color-price);
  margin-left: -5rpx;
}

.goods-desc {
  color: var(--color-text, #333);
}

.custom-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: var(--font-size-xxs);
  font-weight: var(--font-weight-regular);
  color: var(--color-text, #333);
  background: transparent;
  padding: 0;
  margin: 0;
}

.custom-btn::after {
  border: none;
}

.custom-btn-icon {
  height: 50rpx;
}

.custom-btn-text {
  height: 30rpx;
  line-height: 30rpx;
}

.submit-btn-left {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFF;
  min-width: 240rpx;
  width: 100%;
  height: 76rpx;
  opacity: 1;
  border-radius: 38rpx 0 0 38rpx;
}

.submit-btn-right {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFF;
  min-width: 240rpx;
  width: 100%;
  height: 76rpx;
  opacity: 1;
  border-radius: 0 38rpx 38rpx 0;
}