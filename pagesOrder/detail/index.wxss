.order-goods,
.order-total {
  padding: var(--space-page);
}

.order-goods {
  display: flex;
  align-items: center;
}

.order-total {
  text-align: right;
  font-size: var(--font-size-md);
}

.order-pic {
  width: 156rpx;
  height: 156rpx;
  flex-shrink: 0;
  border-radius: var(--radius, 16rpx);
  background: var(--color-bg, #f5f5f5);
}

.order-info {
  flex: 1;
  margin-left: var(--space-page);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 156rpx;
}

.order-bar {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  padding: 16rpx var(--space-page);
}

.order-btn {
  margin-left: 16rpx;
  min-width: 160rpx;
  height: 64rpx;
  line-height: 62rpx;
  padding: 0 24rpx;
  text-align: center;
  border-radius: 999rpx;
  border: 1rpx solid var(--color-border, #f0f0f0);
  font-size: var(--font-size-sm);
  color: var(--color-text);
  background: #fff;
  box-sizing: border-box;
}

.order-btn-primary {
  color: #fff;
}
