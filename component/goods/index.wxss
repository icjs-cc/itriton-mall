/* component/goods/index.wxss */
.goods {
  width: 345rpx;
  height: 520rpx;
  background: #FFFFFF;
  border-radius: var(--radius, 16rpx);
  margin-bottom: 20rpx;
}

.goods-image {
  width: 345rpx;
  height: 345rpx;
  border-radius: var(--radius, 16rpx) var(--radius, 16rpx) 0 0;
}

.goods-content{
  padding: var(--space-card);
}

.goods-name {
  width: 320rpx;
  height: 72rpx;
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-regular);
  line-height: 36rpx;
  color: var(--color-text);
  opacity: 1;
}

.goods-price {
  width: 320rpx;
  height: 30rpx;
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-semibold);
  line-height: 40rpx;
  margin-top: var(--space-section);
}