/* pages/mine/about/index.wxss */
.about{
  background: white;
  padding: 40rpx 24rpx 48rpx;
}

.about-header{
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.about-header__image{
  width: 100%;
  display: block;
  background: transparent;
}

.about-header__text{
  font-size: 28rpx;
  padding: 24rpx 0 0;
  color: var(--color-text, #333);
}

.about-header__desc{
  font-size: 24rpx;
  padding: 8rpx 0 12rpx;
  color: var(--color-text-secondary, #888);
}

.about-content{
  color: #666666;
  font-size: 28rpx;
  line-height: 50rpx;
  padding: 0 20rpx;
}

.about-button{
  margin-top: 40rpx;
  font-size: 28rpx;
  line-height: 80rpx;
  height: 80rpx;
  color: #FFFFFF;
}

.about-button:active{
  opacity: 0.5;
}